{
  "openapi": "3.1.0",
  "info": {
    "title": "StepUp AI Recommendation API",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "summary": "Predict",
        "operationId": "predict_predict_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserProfile"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserProfile": {
        "type": "object",
        "title": "UserProfile",
        "properties": {
          "name": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Name",
            "default": ""
          },
          "email": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Email",
            "default": ""
          },
          "phone": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Phone",
            "default": ""
          },
          "linkedin": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Linkedin",
            "default": ""
          },
          "location": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Location",
            "default": ""
          },
          "major": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Major",
            "default": ""
          },
          "education": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "title": "Education",
            "default": ""
          },
          "semester": {
            "anyOf": [
              { "type": "integer" },
              { "type": "null" }
            ],
            "title": "Semester",
            "default": 0
          },
          "gpa": {
            "anyOf": [
              { "type": "number" },
              { "type": "null" }
            ],
            "title": "Gpa",
            "default": 0.0
          },
          "hard_skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Hard Skills",
            "default": []
          },
          "soft_skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Soft Skills",
            "default": []
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Projects",
            "default": []
          },
          "internships": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Internships",
            "default": []
          },
          "organizations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Organizations",
            "default": []
          },
          "certifications": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Certifications",
            "default": []
          }
        }
      },
      "HTTPValidationError": {
        "type": "object",
        "title": "HTTPValidationError",
        "properties": {
          "detail": {
            "type": "array",
            "title": "Detail",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "title": "ValidationError",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "properties": {
          "loc": {
            "type": "array",
            "title": "Location",
            "items": {
              "anyOf": [
                { "type": "string" },
                { "type": "integer" }
              ]
            }
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        }
      }
    }
  }
}